// Phase 2: switched to the real target — PostgreSQL 16 + TimescaleDB (see
// docs/ARCHITECTURE.md §4). The SQLite migrations from Phases 0/1 were
// dev-only with no real data behind them and have been removed; the Postgres
// baseline migration is generated fresh (see docs/ARCHITECTURE.md-adjacent
// setup notes in the Phase 2 plan) rather than translated by hand. The
// `Telemetry` model below becomes a TimescaleDB hypertable via raw SQL
// (Prisma has no native hypertable/continuous-aggregate support) — see
// apps/api/prisma/timescale/telemetry-hypertable.sql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users      User[]
  devices    Device[]
  alertRules AlertRule[]

  @@map("organizations")
}

model User {
  id             String    @id @default(uuid())
  organizationId String
  email          String    @unique
  passwordHash   String
  name           String
  status         String    @default("active")
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization       Organization             @relation(fields: [organizationId], references: [id])
  roles              UserRole[]
  refreshTokens      RefreshToken[]
  ownedDevices       Device[]                 @relation("DeviceOwner")
  auditLogs          AuditLog[]
  createdAlertRules  AlertRule[]              @relation("AlertRuleCreator")
  acknowledgedAlerts Alert[]                  @relation("AlertAcknowledger")
  resolvedAlerts     Alert[]                  @relation("AlertResolver")
  notifications      Notification[]
  notificationPrefs  NotificationPreference[]
  aiInteractions     AiInteraction[]

  @@index([organizationId])
  @@map("users")
}

/// Global RBAC catalog (see docs/ARCHITECTURE.md §8). Roles/permissions are
/// not org-scoped — every org draws from the same catalog, seeded by
/// prisma/seed.ts.
model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Hashed, revocable, rotated-on-use (see docs/ARCHITECTURE.md §8) — never
/// stores the raw refresh token, only its hash.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Device {
  id              String    @id @default(uuid())
  organizationId  String
  name            String
  type            String
  model           String?
  status          String    @default("unknown")
  firmwareVersion String?
  hardwareVersion String?
  macAddress      String?
  ownerUserId     String?
  lastSeenAt      DateTime?
  metadata        String? // JSON-encoded; see DevicesService for (de)serialization
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deactivatedAt   DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id])
  owner        User?              @relation("DeviceOwner", fields: [ownerUserId], references: [id])
  credentials  DeviceCredential[]
  telemetry    Telemetry[]
  events       DeviceEvent[]
  alertRules   AlertRule[]
  alerts       Alert[]

  @@index([organizationId, status])
  @@map("devices")
}

/// credentialHash is a fast SHA-256 digest, not argon2: this secures a
/// high-entropy generated token (not a human-chosen password), so a slow KDF
/// buys nothing and only adds latency — same convention as GitHub/Stripe API
/// keys.
model DeviceCredential {
  id             String    @id @default(uuid())
  deviceId       String
  credentialType String    @default("mqtt_token")
  credentialHash String
  issuedAt       DateTime  @default(now())
  rotatedAt      DateTime?
  revokedAt      DateTime?

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@map("device_credentials")
}

/// TimescaleDB hypertable (converted via raw SQL, see
/// apps/api/prisma/timescale/telemetry-hypertable.sql). `ts` is the
/// device-reported timestamp, not server receipt time — the dedup story
/// (a re-delivered QoS1 message upserts onto the same row instead of
/// creating a duplicate) only holds if `ts` is stable across redelivery.
/// Server receipt time is preserved inside `payload.receivedAt` for
/// reconciliation when clock skew forces a clamp (see TelemetryIngestionProcessor).
model Telemetry {
  deviceId String
  ts       DateTime
  metric   String
  value    Float
  payload  Json?

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([deviceId, ts, metric])
  @@map("telemetry")
}

model DeviceEvent {
  id        String   @id @default(uuid())
  deviceId  String
  eventType String
  payload   Json?
  ts        DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, ts])
  @@map("device_events")
}

/// docs/ARCHITECTURE.md §4. `deviceId` null means "every device in the org",
/// which is why rule lookup at ingest matches on `deviceId IN (thisDevice, NULL)`.
/// `thresholdSecondary` is the upper bound and is only meaningful for the
/// `range` condition — the schema sketch lists a single `threshold`, but a
/// range needs two numbers and nothing else in the row can carry the second.
model AlertRule {
  id                 String   @id @default(uuid())
  organizationId     String
  deviceId           String?
  metric             String
  condition          String
  threshold          Float
  thresholdSecondary Float?
  severity           String   @default("warning")
  enabled            Boolean  @default(true)
  createdBy          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  device       Device?      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  creator      User?        @relation("AlertRuleCreator", fields: [createdBy], references: [id])
  alerts       Alert[]

  @@index([organizationId, enabled])
  @@index([deviceId, metric])
  @@map("alert_rules")
}

/// One row per breach episode, not per breaching reading: while a rule stays
/// breached its alert stays open, and it is resolved (automatically by the
/// sweep, or by a person) when the metric recovers. See AlertEvaluationService.
model Alert {
  id             String    @id @default(uuid())
  ruleId         String
  deviceId       String
  metric         String
  status         String    @default("open")
  severity       String
  message        String
  context        Json?
  triggeredAt    DateTime  @default(now())
  acknowledgedAt DateTime?
  acknowledgedBy String?
  resolvedAt     DateTime?
  resolvedBy     String?

  rule         AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  device       Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  acknowledger User?     @relation("AlertAcknowledger", fields: [acknowledgedBy], references: [id])
  resolver     User?     @relation("AlertResolver", fields: [resolvedBy], references: [id])

  @@index([status, severity, triggeredAt])
  @@index([deviceId, triggeredAt])
  /// Enforces the one-open-alert-per-rule-and-device rule at the database
  /// level, so two concurrent ingestion workers racing on the same breach
  /// can't both open one. Partial (status <> 'resolved') — added by raw SQL
  /// in the migration, since Prisma cannot express a filtered unique index.
  @@map("alerts")
}

model Notification {
  id                String    @id @default(uuid())
  userId            String
  type              String
  title             String
  body              String
  relatedEntityType String?
  relatedEntityId   String?
  readAt            DateTime?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

/// Absence of a row means "enabled" — a user who has never touched their
/// preferences still gets notified, and only an explicit opt-out is stored.
model NotificationPreference {
  id        String  @id @default(uuid())
  userId    String
  eventType String
  channel   String
  enabled   Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventType, channel])
  @@map("notification_preferences")
}

/// docs/ARCHITECTURE.md §9: every AI call is logged here for audit AND cost
/// control. `inputContext` records the bounded, authorized context the builder
/// assembled — never raw credentials, never another org's data — so a
/// surprising answer can be traced back to what the model was actually shown.
model AiInteraction {
  id               String   @id @default(uuid())
  userId           String
  organizationId   String
  provider         String
  model            String
  requestType      String
  inputContext     Json?
  prompt           String
  response         String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  /// USD, estimated from the provider's published per-token pricing at call
  /// time — indicative, not a billing record.
  costEstimate     Float    @default(0)
  latencyMs        Int      @default(0)
  /// Set when the provider call failed; `response` then holds the error text.
  errorCode        String?
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
  @@map("ai_interactions")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  ipAddress   String?
  metadata    String? // JSON-encoded; see AuditService
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@map("audit_logs")
}
