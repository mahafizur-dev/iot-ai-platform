# Copy to .env for local development.

NODE_ENV=development
PORT=4000

# Phase 1 (this environment): local SQLite file — no Docker/Postgres access.
# Real target per docs/ARCHITECTURE.md: postgresql://user:pass@localhost:5432/iot_ai_platform
DATABASE_URL="file:./prisma/dev.db"

# Frontend origin allowed to call this API.
CORS_ORIGIN="http://localhost:3000"

# Auth secrets — generate real values with e.g. `openssl rand -hex 32`.
# Never commit real secrets; these are local-dev placeholders only.
JWT_ACCESS_SECRET="dev-only-access-secret-change-me-please-32chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me-please-32chars"
JWT_REFRESH_EXPIRES_IN="7d"
