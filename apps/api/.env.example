# Copy to .env for local development.

NODE_ENV=development
PORT=4000

# Postgres + TimescaleDB — matches infra/docker-compose.yml's `db` service defaults.
DATABASE_URL="postgresql://iot_ai_platform:iot_ai_platform@localhost:5432/iot_ai_platform"

# Frontend origin allowed to call this API.
CORS_ORIGIN="http://localhost:3000"

# Auth secrets — generate real values with e.g. `openssl rand -hex 32`.
# Never commit real secrets; these are local-dev placeholders only.
JWT_ACCESS_SECRET="dev-only-access-secret-change-me-please-32chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me-please-32chars"
JWT_REFRESH_EXPIRES_IN="7d"

# MQTT / telemetry ingestion (see docs/ARCHITECTURE.md §6) — matches
# infra/docker-compose.yml's `emqx`/`redis` services.
MQTT_BROKER_URL="mqtt://localhost:1883"
# MQTT_USERNAME / MQTT_PASSWORD: only needed if EMQX is configured to require
# auth for the backend's own subscriber connection (it's a privileged internal
# client, distinct from per-device credentials).
REDIS_URL="redis://localhost:6379"
EMQX_AUTH_HOOK_SECRET="dev-only-emqx-hook-secret-change-me"
DEVICE_OFFLINE_THRESHOLD_SECONDS=90

# Rate limiting (see docs/ARCHITECTURE.md §8).
RATE_LIMIT_PER_MINUTE=100
AUTH_RATE_LIMIT_PER_MINUTE=10

# AI (see docs/ARCHITECTURE.md §9).
# "mock" is the default so a fresh checkout runs the AI features end to end
# with no key and no spend. Switch to "anthropic" and supply a key for real
# responses.
AI_PROVIDER="mock"
# ANTHROPIC_API_KEY="sk-ant-..."
AI_MODEL="claude-sonnet-5"
AI_MAX_TOKENS=1024
AI_RATE_LIMIT_PER_MINUTE=10
